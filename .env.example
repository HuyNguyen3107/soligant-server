# Server Configuration
PORT=3000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/your-database-name

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Auth cookies (httpOnly). Override SameSite when frontend and API live on
# different sites in production (e.g. app.example.com + api.example.com):
#   COOKIE_SAMESITE=none
# Defaults: "lax" in development, "none" in production.
# COOKIE_SAMESITE=lax

# Request body limit (defaults to 5mb)
# REQUEST_BODY_LIMIT=5mb
